# Required at runtime; never commit a real credential.
OPENAI_API_KEY=

# Set the model identifiers at runtime. The package has no provider-specific
# model or endpoint defaults.
OPENAI_MODEL=
TASK_PLAN_MODEL=
TASK_PLAN_EXECUTOR_MODEL=
NUMBERED_FIXED_MODEL=

# Optional for an OpenAI-compatible local server. Leave unset for the
# official OpenAI SDK default.
OPENAI_BASE_URL=
